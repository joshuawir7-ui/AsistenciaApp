{
  "name": "verificacion-de-asistencia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "sync-mobile": "npm run build && npx cap sync",
    "android:run": "node build-apk.cjs",
    "android:build": "node build-apk.cjs",
    "build:apk": "node build-apk.cjs",
    "electron:dev": "concurrently \"vite --host\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "node build-exe.cjs",
    "build:exe": "node build-exe.cjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3"
  },
  "build": {
    "appId": "com.antigravity.asistencia",
    "productName": "AsistenciaApp",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.png"
    }
  }
}
